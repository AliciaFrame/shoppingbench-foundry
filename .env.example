AZURE_LOCATION=swedencentral
AZURE_SEARCH_LOCATION=swedencentral
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=shoppingbench-products

# Local single-task evaluation can set the generic MAI_* pair directly.
MAI_OPENAI_BASE_URL=https://<model-resource>.openai.azure.com/openai/v1
MAI_MODEL_DEPLOYMENT_NAME=<mai-code-deployment>

# Hosted deployment uses task-specific values so agents can target different
# base or fine-tuned deployments without sharing one accidental override.
PRODUCT_OPENAI_BASE_URL=https://<base-model-resource>.openai.azure.com/openai/v1
PRODUCT_MODEL_DEPLOYMENT_NAME=<base-model-deployment>
SHOP_OPENAI_BASE_URL=https://<base-model-resource>.openai.azure.com/openai/v1
SHOP_MODEL_DEPLOYMENT_NAME=<base-model-deployment>
VOUCHER_OPENAI_BASE_URL=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>/openai/v1
VOUCHER_MODEL_DEPLOYMENT_NAME=<voucher-model-deployment>
WEB_OPENAI_BASE_URL=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>/openai/v1
WEB_MODEL_DEPLOYMENT_NAME=<web-model-deployment>
# Web (live) agent: MAI-Code-1.1-Flash base or fine-tuned deployment.
WEB_LIVE_OPENAI_BASE_URL=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>/openai/v1
WEB_LIVE_MODEL_DEPLOYMENT_NAME=<web-live-model-deployment>
# Web (live): fixed web-search lookup step and the published agent settings.
WEB_SEARCH_OPENAI_BASE_URL=https://<foundry-resource>.services.ai.azure.com/openai/v1
WEB_SEARCH_MODEL_DEPLOYMENT_NAME=<gpt-5.4-mini-deployment>
WEB_SEARCH_MAX_OUTPUT_TOKENS=256
WEB_SEARCH_MAX_ATTEMPTS=3
WEB_SEARCH_SOURCE_LIMIT=2
SELECTION_MAX_OUTPUT_TOKENS=4096
SELECTION_REASONING_EFFORT=medium
MAX_TOOL_STEPS=8
CATALOG_SEARCH_RESULT_LIMIT=10
MAX_CATALOG_SEARCHES=2
MAX_PRODUCT_VIEWS=2
ENFORCE_SELECTION_TOOL_LIMITS=false
# Web (live) RFT judge, called on WEB_SEARCH_OPENAI_BASE_URL. Grader endpoints
# retry only unreachable or throttled judge calls, then return 503.
RFT_GRADER_MODEL_DEPLOYMENT_NAME=<gpt-5.4-judge-deployment>
RFT_GRADER_TRANSPORT_ATTEMPTS=4
RFT_GRADER_TRANSPORT_BACKOFF_SECONDS=2
# Leave unset for published results: setting it makes the Web (live) runtime
# serve catalog tools from this local file instead of SHOPPINGBENCH_TOOL_URL.
# SHOPPINGBENCH_DOCUMENTS_PATH=data/prepared/search-documents.jsonl

FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
SHOPPINGBENCH_TOOL_URL=http://localhost:8000
SHOPPINGBENCH_TOOL_BASE_URL=http://localhost:8000
SHOPPINGBENCH_API_TOKEN=<generate-a-secret-at-least-32-characters>
SHOPPINGBENCH_ALLOW_ANONYMOUS=false

# RFT is optional and requires a resource/model that supports reinforcement
# fine-tuning. Use values available to your Azure subscription.
MAI_RFT_BASE_URL=https://<rft-resource>.openai.azure.com/openai/v1
MAI_RFT_MODEL=<rft-capable-model>
MAI_RFT_TRAINING_TYPE=globalStandard
